{
  "name": "pihole-manager",
  "version": "2.0.0",
  "type": "module",
  "description": "Multi-instance Pi-hole management dashboard",
  "scripts": {
    "dev": "vite",
    "build": "ionic build",
    "prod": "ionic build --prod",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.ts",
    "lint:fix": "eslint . --ext .vue,.ts --fix"
  },
  "dependencies": {
    "@ionic/vue": "^8.8.7",
    "@ionic/vue-router": "^8.8.7",
    "ionicons": "^8.0.13",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7",
    "pinia": "^3.0.4",
    "axios": "^1.16.1",
    "chart.js": "^4.5.1",
    "date-fns": "^4.2.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.7",
    "@vue/test-utils": "^2.4.10",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.1",
    "vite": "^8.0.13",
    "vitest": "^4.1.7",
    "eslint": "^10.4.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint-plugin-vue": "^10.9.1"
  }
