{
  "name": "pihole-manager",
  "version": "2.0.0",
  "type": "module",
  "description": "Multi-instance Pi-hole management dashboard",
  "scripts": {
    "dev": "vite",
    "build": "ionic build",
    "prod": "ionic build --prod",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.ts",
    "lint:fix": "eslint . --ext .vue,.ts --fix"
  },
  "dependencies": {
    "@ionic/vue": "^8.8.2",
    "@ionic/vue-router": "^8.8.2",
    "ionicons": "^8.0.13",
    "vue": "^3.5.31",
    "vue-router": "^5.0.4",
    "pinia": "^3.0.4",
    "axios": "^1.13.6",
    "chart.js": "^4.5.1",
    "date-fns": "^4.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.2",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.8.8",
    "jsdom": "^29.0.1",
    "typescript": "^6.0.2",
    "vue-tsc": "^3.2.6",
    "vite": "^8.0.3",
    "vitest": "^4.1.2",
    "eslint": "^10.1.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint-plugin-vue": "^10.8.0"
  }
